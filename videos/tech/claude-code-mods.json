        },
        {
          "at": "rewrite the event",
          "packet": {
            "from": "mod",
            "to": "cc",
            "label": "changed",
            "color": "yellow"
          },
          "note": {
            "text": "*Rewrite*: change it",
            "tone": "warn"
          }
        },
        {
          "at": "answer it itself",
          "packet": {
            "from": "mod",
            "to": "cc",
            "label": "answer",
            "color": "green"
          },
          "note": {
            "text": "*Answer*: take over",
            "tone": "good"
          }
        },
        {
          "at": "never runs",
          "status": {
            "mod": "ok"
          }
        }
