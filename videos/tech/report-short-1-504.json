        {
          "at": "recibido pero no",
          "note": {
            "text": "*202* = recibido, aún no listo",
            "tone": "good"
          }
        },
        {
          "at": "genera el reporte aparte",
          "note": {
            "text": "Lo pesado, *aparte*",
            "tone": "good"
          }
