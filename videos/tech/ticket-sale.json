  "scenes": [
    {
      "type": "title",
      "tag": "System design",
      "heading": "Why does every *ticket sale* crash?",
      "subheading": "From 500 seats to millions of fans",
      "chapter": "The question",
      "narration": "Every time a huge tour goes on sale, the site crashes. So how would you design ticket sales? Like a real project: start with something simple that works, and fix it only when it breaks.",
      "beats": [
        {
          "text": "Fans",
          "icon": "users",
          "at": "a huge tour"
        },
        {
          "text": "Seats",
          "icon": "db",
          "at": "goes on sale"
        },
        {
          "text": "Payment",
          "icon": "external",
          "at": "design ticket sales"
        },
        {
          "text": "?",
          "at": "fix it only"
        }
      ]
    },
    {
      "type": "callout",
      "text": "500 seats",
      "caption": "a local band · a few hundred fans over a day",
      "tone": "info",
      "icon": "users",
      "sfx": "impact",
      "chapter": "Start simple",
      "narration": "Start small: a local band, five hundred seats, and a few hundred fans buying over a whole day."
    },
    {
      "type": "board",
      "title": "The simple version",
      "narration": "The simple version is three pieces. Fans open the site and pick a seat. The backend checks that the seat is free and marks it sold. And the database keeps every seat with its status.",
      "steps": [
        {
          "at": "three pieces",
          "show": [
            "fans",
            "api",
            "db"
          ],
          "camera": []
        },
        {
          "at": "pick a seat",
          "packet": {
            "from": "fans",
            "to": "api",
            "label": "buy A12",
            "color": "blue"
          }
        },
        {
          "at": "checks that the seat",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "A12 free?",
            "color": "yellow"
          },
          "status": {
            "db": "busy"
          }
        },
        {
          "at": "marks it sold",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "A12 = sold",
            "color": "green"
          },
          "status": {
            "db": "ok"
          }
        },
        {
          "at": "every seat with",
          "note": {
            "text": "Seats: *free* or *sold*",
            "tone": "info"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Need anything else?",
      "narration": "With a few hundred fans spread over a day, that's enough. No queue, no cache, no extra servers. This version works, and you could ship it today.",
      "steps": [
        {
          "at": "that's enough",
          "status": {
            "fans": "ok",
            "api": "ok",
            "db": "ok"
          },
          "note": {
            "text": "A few hundred fans: *enough*",
            "tone": "good"
          }
        },
        {
          "at": "No queue",
          "note": {
            "text": "Every extra piece = *one more thing to break*",
            "tone": "info"
          }
        },
        {
          "at": "ship it today",
          "camera": [],
          "note": {
            "text": "Simple version: *works and ships*",
            "tone": "good"
          }
        }
      ]
    },
    {
      "type": "callout",
      "text": "Same seat",
      "caption": "two fans click A12 at the same moment",
      "tone": "warn",
      "icon": "users",
      "sfx": "impact",
      "chapter": "Two fans, one seat",
      "narration": "But what happens when two fans click the same seat at the same moment?"
    },
    {
      "type": "board",
      "title": "What breaks",
      "narration": "Both requests ask the database: is A12 free? Both get yes. Both mark it sold. Now two people paid for one seat. That's a race condition: the check and the write were two separate steps.",
      "steps": [
        {
          "at": "Both requests ask",
          "status": {
            "fans": "idle",
            "api": "idle",
            "db": "idle"
          },
          "packet": {
            "from": "fans",
            "to": "api",
            "label": "A12 ×2",
            "color": "orange"
          }
        },
        {
          "at": "Both get yes",
          "packet": {
            "from": "db",
            "to": "api",
            "label": "free · free",
            "color": "yellow"
          }
        },
        {
          "at": "Both mark it sold",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "sold ×2",
            "color": "red"
          },
          "status": {
            "db": "error"
          },
          "sfx": "riser"
        },
        {
          "at": "for one seat",
          "note": {
            "text": "1 seat, *2 tickets*",
            "tone": "bad"
          }
        },
        {
          "at": "two separate steps",
          "focus": [
            "api",
            "db"
          ],
          "note": {
            "text": "Race condition: *check, then write*",
            "tone": "warn"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "One atomic step",
      "narration": "The fix: make the check and the write one step. The backend tells the database: mark A12 sold, only if it's still free. The first request wins. The second changes zero rows, and that fan picks another seat.",
      "steps": [
        {
          "at": "the write one step",
          "status": {
            "db": "idle"
          },
          "note": {
            "text": "Check + write = *one step*",
            "tone": "good"
          }
        },
        {
          "at": "only if it's still free",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "sold IF free",
            "color": "green"
          }
        },
        {
          "at": "first request wins",
          "packet": {
            "from": "db",
            "to": "api",
            "label": "updated: 1",
            "color": "green"
          },
          "status": {
            "fans": "ok"
          }
        },
        {
          "at": "changes zero rows",
          "packet": {
            "from": "db",
            "to": "api",
            "label": "updated: 0",
            "color": "orange"
          }
        },
        {
          "at": "picks another seat",
          "focus": [],
          "note": {
            "text": "Second fan: *pick another seat*",
            "tone": "info"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Four seats together",
      "narration": "And fans rarely buy one seat; they want four together. If you hold them one by one, the second can fail after the first succeeded, and the fan is left with half a group. So hold all four in one transaction: all or nothing.",
      "steps": [
        {
          "at": "want four together",
          "packet": {
            "from": "fans",
            "to": "api",
            "label": "4 seats",
            "color": "blue"
          },
          "note": {
            "text": "Group: *4 seats together*",
            "tone": "info"
          }
        },
        {
          "at": "one by one",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "A12 ✓  A13 ✗",
            "color": "orange"
          },
          "status": {
            "db": "warn"
          }
        },
        {
          "at": "half a group",
          "note": {
            "text": "Partial: *half a group*",
            "tone": "bad"
          }
        },
        {
          "at": "one transaction",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "hold 4 IF all free",
            "color": "green"
          },
          "status": {
            "db": "ok"
          }
        },
        {
          "at": "all or nothing",
          "note": {
            "text": "*All 4 or none*",
            "tone": "good"
          }
        }
      ]
    },
    {
      "type": "callout",
      "text": "Minutes",
      "caption": "between picking a seat and paying",
      "tone": "warn",
      "icon": "external",
      "sfx": "clock",
      "chapter": "Hold the seat",
      "narration": "Next problem: paying isn't instant. Between picking a seat and finishing the payment, a fan needs a few minutes."
    },
    {
      "type": "board",
      "title": "Hold the seat",
      "narration": "So you don't sell the seat at the click: you hold it. The seat goes from free to held, with an expiry time, while the fan pays. When the payment goes through, it becomes sold.",
      "steps": [
        {
          "at": "you hold it",
          "status": {
            "fans": "idle",
            "api": "idle",
            "db": "idle"
          },
          "packet": {
            "from": "api",
            "to": "db",
            "label": "A12 = held",
            "color": "yellow"
          },
          "note": {
            "text": "free → *held* → sold",
            "tone": "info"
          }
        },
        {
          "at": "with an expiry time",
          "note": {
            "text": "Held, *with a timer*",
            "tone": "warn"
          }
        },
        {
          "at": "while the fan pays",
          "show": [
            "pay"
          ],
          "packet": {
            "from": "api",
            "to": "pay",
            "label": "pay",
            "color": "blue"
          },
          "status": {
            "pay": "busy"
          }
        },
        {
          "at": "payment goes through",
          "packet": {
            "from": "pay",
            "to": "api",
            "label": "paid",
            "color": "green"
          },
          "status": {
            "pay": "ok"
          }
        },
        {
          "at": "becomes sold",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "A12 = sold",
            "color": "green"
          },
          "status": {
            "db": "ok"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "When they walk away",
      "narration": "And if the fan closes the tab? A small job checks for expired holds every minute and frees those seats, so nobody keeps a seat they never paid for.",
      "steps": [
        {
          "at": "closes the tab",
          "status": {
            "fans": "warn",
            "pay": "idle",
            "db": "idle"
          },
          "focus": [
            "fans"
          ]
        },
        {
          "at": "A small job",
          "show": [
            "expiry"
          ],
          "focus": [
            "expiry",
            "db"
          ],
          "note": {
            "text": "Expiry job: *every minute*",
            "tone": "info"
          }
        },
        {
          "at": "frees those seats",
          "packet": {
            "from": "expiry",
            "to": "db",
            "label": "free expired",
            "color": "green"
          },
          "status": {
            "expiry": "busy"
          }
        },
        {
          "at": "never paid for",
          "focus": [],
          "status": {
            "fans": "idle",
            "expiry": "idle"
          },
          "note": {
            "text": "Expired hold → *free again*",
            "tone": "good"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Paid, but too late",
      "chapter": "When the payment goes wrong",
      "narration": "Now a nastier case. The fan pays in the last second, the hold expires while the payment is processing, and another fan takes the seat. Money taken, seat gone. So when the payment confirms, mark the seat sold only if the hold is still theirs. If it isn't, refund.",
      "steps": [
        {
          "at": "pays in the last second",
          "packet": {
            "from": "api",
            "to": "pay",
            "label": "pay",
            "color": "blue"
          },
          "status": {
            "pay": "busy",
            "db": "idle",
            "fans": "idle"
          },
          "focus": [
            "fans",
            "api",
            "pay",
            "db"
          ],
          "note": {
            "text": "Pays at *the last second*",
            "tone": "warn"
          }
        },
        {
          "at": "another fan takes the seat",
          "packet": {
            "from": "expiry",
            "to": "db",
            "label": "hold expired",
            "color": "gray"
          },
          "status": {
            "db": "warn"
          }
        },
        {
          "at": "Money taken, seat gone",
          "status": {
            "pay": "ok",
            "db": "error"
          },
          "note": {
            "text": "Money taken, *seat gone*",
            "tone": "bad"
          },
          "sfx": "cash"
        },
        {
          "at": "only if the hold is still theirs",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "sold IF mine",
            "color": "green"
          },
          "status": {
            "db": "idle",
            "pay": "idle"
          },
          "note": {
            "text": "Confirm *only if the hold is yours*",
            "tone": "good"
          }
        },
        {
          "at": "refund",
          "packet": {
            "from": "pay",
            "to": "api",
            "label": "refund",
            "color": "orange"
          },
          "status": {
            "api": "ok"
          },
          "focus": [],
          "note": {
            "text": "Not yours? *Refund*",
            "tone": "info"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Charged twice",
      "narration": "And the backend can crash right after charging, before it marks the seat sold. When the request is retried, it must not charge again. So every payment carries an idempotency key, and the provider returns the first result instead of charging twice.",
      "steps": [
        {
          "at": "crash right after charging",
          "focus": [
            "api",
            "pay"
          ],
          "packet": {
            "from": "api",
            "to": "pay",
            "label": "pay · key K1",
            "color": "blue"
          },
          "status": {
            "api": "error",
            "pay": "ok"
          },
          "note": {
            "text": "Crash *after* charging",
            "tone": "bad"
          }
        },
        {
          "at": "must not charge again",
          "status": {
            "api": "busy"
          },
          "packet": {
            "from": "api",
            "to": "pay",
            "label": "retry · key K1",
            "color": "orange"
          }
        },
        {
          "at": "idempotency key",
          "note": {
            "text": "Idempotency key: *same key, same result*",
            "tone": "good"
          }
        },
        {
          "at": "instead of charging twice",
          "packet": {
            "from": "pay",
            "to": "api",
            "label": "already paid",
            "color": "green"
          },
          "status": {
            "api": "ok",
            "pay": "ok"
          },
          "focus": [],
          "note": {
            "text": "*One charge*, even with retries",
            "tone": "good"
          },
          "sfx": "success"
        }
      ]
    },
    {
      "type": "callout",
      "text": "3.5 billion",
      "caption": "requests in one presale · 4× the previous peak",
      "tone": "bad",
      "icon": "users",
      "sfx": "impact",
      "chapter": "Millions at once",
      "narration": "Now the big one. In 2022, one presale got three and a half billion requests: four times the ticket company's previous peak. What happens to our design?"
    },
    {
      "type": "board",
      "title": "What breaks now",
      "narration": "Everybody arrives in the same minute and keeps hitting refresh. The backend runs out of capacity, the database is flooded with seat checks, and some fans even lose the seats already in their cart.",
      "steps": [
        {
          "at": "the same minute",
          "camera": [],
          "packet": {
            "from": "fans",
            "to": "api",
            "label": "×millions",
            "color": "red"
          }
        },
        {
          "at": "hitting refresh",
          "packet": {
            "from": "fans",
            "to": "api",
            "label": "refresh",
            "color": "red"
          },
          "status": {
            "api": "busy"
          }
        },
        {
          "at": "runs out of capacity",
          "status": {
            "api": "error"
          }
        },
        {
          "at": "flooded with seat checks",
          "packet": {
            "from": "api",
            "to": "db",
            "label": "A12? A13? A14?",
            "color": "orange"
          },
          "status": {
            "db": "error"
          },
          "sfx": "alarm"
        },
        {
          "at": "already in their cart",
          "note": {
            "text": "Random errors, *lost carts*",
            "tone": "bad"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "The numbers",
      "narration": "Let's size it, with an example. A hundred thousand fans, each refreshing twenty times a minute, is about thirty-three thousand requests per second. And almost all of it is reads: people looking at the seat map. Buying is a small part, fighting for a fixed number of seats.",
      "steps": [
        {
          "at": "A hundred thousand fans",
          "focus": [
            "fans"
          ],
          "status": {
            "api": "idle",
            "db": "idle"
          },
          "note": {
            "text": "Example: *100k fans* × 20 refreshes/min",
            "tone": "info"
          }
        },
        {
          "at": "thirty-three thousand requests",
          "packet": {
            "from": "fans",
            "to": "api",
            "label": "33k req/s",
            "color": "red"
          },
          "note": {
            "text": "≈ *33k requests per second*",
            "tone": "warn"
          }
        },
        {
          "at": "people looking at",
          "note": {
            "text": "Mostly *reads*: the seat map",
            "tone": "info"
          }
        },
        {
          "at": "fixed number of seats",
          "focus": [
            "fans",
            "api",
            "db"
          ],
          "note": {
            "text": "Writes: *few, same seats*",
            "tone": "warn"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Scale out",
      "chapter": "Scale out first",
      "narration": "The first move any engineer makes: scale out. The backend doesn't keep anything between requests, so you can run many copies of it, and put a load balancer in front to spread the traffic across them.",
      "steps": [
        {
          "at": "scale out",
          "status": {
            "api": "idle",
            "db": "idle"
          },
          "focus": [
            "api"
          ]
        },
        {
          "at": "doesn't keep anything",
          "note": {
            "text": "Stateless backend → *add copies*",
            "tone": "good"
          }
        },
        {
          "at": "many copies of it",
          "show": [
            "copies"
          ],
          "focus": [
            "api",
            "copies"
          ]
        },
        {
          "at": "a load balancer",
          "show": [
            "lb"
          ],
          "hide": [
            "fans->api"
          ],
          "focus": [
            "fans",
            "lb",
            "api",
            "copies"
          ],
          "sfx": "impact"
        },
        {
          "at": "spread the traffic",
          "packet": {
            "from": "lb",
            "to": "copies",
            "label": "requests",
            "color": "blue"
          },
          "status": {
            "api": "ok",
            "copies": "ok"
          },
          "note": {
            "text": "Load balancer = *spreads the traffic*",
            "tone": "info"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Cache what people look at",
      "narration": "And most of that traffic is people looking, not buying: the seat map, refreshed again and again. So serve it from a CDN, servers close to the fans that keep a copy. If the map is a few seconds old, that's fine: the one-step write still decides who gets the seat.",
      "steps": [
        {
          "at": "people looking, not buying",
          "focus": [
            "fans"
          ]
        },
        {
          "at": "serve it from a CDN",
          "show": [
            "cdn"
          ],
          "packet": {
            "from": "fans",
            "to": "cdn",
            "label": "seat map",
            "color": "teal"
          },
          "focus": [
            "fans",
            "cdn"
          ],
          "status": {
            "cdn": "busy"
          }
        },
        {
          "at": "keep a copy",
          "note": {
            "text": "Reads → *CDN*, not the backend",
            "tone": "good"
          }
        },
        {
          "at": "a few seconds old",
          "note": {
            "text": "Map can lag: *the write decides*",
            "tone": "info"
          }
        },
        {
          "at": "who gets the seat",
          "focus": [],
          "camera": [],
          "status": {
            "cdn": "ok"
          }
        }
      ]
    },
    {
      "type": "board",
      "title": "Where it still breaks",
