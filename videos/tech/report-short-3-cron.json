        "col": 2,
        "sub": "ventas"
      },
      {
        "id": "store",
        "label": "S3",
        "icon": "storage",
        "row": 2,
        "col": 0,
        "sub": "archivos"
      },
      {
        "id": "worker",
        "label": "Worker",
        "icon": "worker",
        "row": 2,
        "col": 1,
