{
  "id": "report-short-3-cron",
  "title": "200 personas piden el mismo reporte: ¿lo generas 200 veces?",
  "lang": "es",
  "pack": "tech",
  "theme": "light",
  "board": {
    "nodes": [
      {
        "id": "frontend",
